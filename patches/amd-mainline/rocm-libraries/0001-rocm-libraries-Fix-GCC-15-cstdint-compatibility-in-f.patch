From a7cff007f0a6064a71cb5b6c92b6a3c4c89625c5 Mon Sep 17 00:00:00 2001
From: therockbot <therockbot@amd.com>
Date: Wed, 28 Jan 2026 04:59:42 -0700
Subject: [PATCH] rocm-libraries: Fix GCC 15 cstdint compatibility in float
 type headers

GCC 15's libstdc++ <cstdint> header requires C integer types to already
be defined in the global namespace before inclusion. When compiling with
Clang using GCC 15's headers (common on Fedora 43+), including <cstdint>
before <stdint.h> causes errors like:

  error: no member named 'intptr_t' in the global namespace
  error: no member named 'uint_fast8_t' in the global namespace

Fix by including <stdint.h> before <cstdint> in the C++/HIP code paths
of the following headers:
  - rocblas: rocblas_bfloat16.h, rocblas_xfloat32.h
  - rocsparse: rocsparse_bfloat16.h
  - hipblaslt: hipblaslt_xfloat32.h
  - tensile: tensile_bfloat16.h (shared and hipblaslt copies)

See-also: https://gcc.gnu.org/gcc-15/porting_to.html
---
 .../hipblaslt/library/include/hipblaslt/hipblaslt_xfloat32.h     | 1 +
 projects/hipblaslt/tensilelite/Tensile/Source/tensile_bfloat16.h | 1 +
 projects/rocblas/library/include/internal/rocblas_bfloat16.h     | 1 +
 projects/rocblas/library/include/internal/rocblas_xfloat32.h     | 1 +
 projects/rocsparse/library/include/rocsparse_bfloat16.h          | 1 +
 shared/tensile/Tensile/Source/tensile_bfloat16.h                 | 1 +
 6 files changed, 6 insertions(+)

diff --git a/projects/hipblaslt/library/include/hipblaslt/hipblaslt_xfloat32.h b/projects/hipblaslt/library/include/hipblaslt/hipblaslt_xfloat32.h
index a71bd2d94d..a8d570f499 100644
--- a/projects/hipblaslt/library/include/hipblaslt/hipblaslt_xfloat32.h
+++ b/projects/hipblaslt/library/include/hipblaslt/hipblaslt_xfloat32.h
@@ -43,6 +43,7 @@ typedef struct
 
 #else // __cplusplus < 201103L || (!defined(__HCC__) && !defined(__HIPCC__))
 
+#include <stdint.h> // GCC 15: must precede <cstdint> to populate global namespace
 #include <cmath>
 #include <cstddef>
 #include <cstdint>
